NUXT_PUBLIC_API_BASE=http://localhost:8888

# Midtrans payment (client key publik — aman untuk frontend)
# NUXT_PUBLIC_MIDTRANS_ENV: "sandbox" (pengembangan) atau "production" (rilis)
# NUXT_PUBLIC_MIDTRANS_CLIENT_KEY: client key dari dashboard Midtrans
#   sandbox    -> SB-Mid-client-xxxx
#   production -> Mid-client-xxxx
NUXT_PUBLIC_MIDTRANS_ENV=sandbox
NUXT_PUBLIC_MIDTRANS_CLIENT_KEY=
